# Copy to .env for local dev. In production these are set via
# docker-compose.yml's `environment:` block instead — never
# baked into the image itself.

# Port the HTTP + Socket.IO server listens on inside the container.
PORT=3001

# Must stay 0.0.0.0 in Docker. 127.0.0.1 would only accept connections
# from inside the container itself — nginx wouldn't be able to reach it.
HOST=0.0.0.0

# Comma-separated list of origins allowed to open a Socket.IO connection.
# Set this to your real domain in production:
# CORS_ORIGIN=https://yourdomain.com
CORS_ORIGIN=http://localhost:5173

# Game timing (ms)
REVEAL_DURATION_MS=3000
LEADERBOARD_DURATION_MS=3000
ROOM_CAPACITY_LIMIT=40

# WebSocket permessage-deflate. Off by default. Messages smaller than the
# threshold (bytes) are sent uncompressed; 0 compresses every message.
SOCKET_PER_MESSAGE_DEFLATE=false
SOCKET_PER_MESSAGE_DEFLATE_THRESHOLD=1024

# Room cleanup TTLs (ms)
ROOM_NO_CONNECTED_MEMBERS_TTL=600000
ROOM_HOST_DISCONNECTED_IN_GROUP_TTL=300000
ROOM_HOST_DISCONNECTED_IN_CLASSROOM_TTL=180000
ROOM_FINISHED_TTL=900000

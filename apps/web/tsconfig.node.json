{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"composite": true,
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "ESNext",
		"types": ["node"],
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": ["vite.config.ts", "vite"]
}

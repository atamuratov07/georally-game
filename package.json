{
	"name": "georally-game",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"check": "pnpm -r check",
		"dev:web": "pnpm -F @georally/web dev",
		"build:web": "pnpm -F @georally/web build",
		"preview:web": "pnpm -F @georally/web preview",
		"dev:server": "pnpm -F @georally/server dev",
		"build:server": "pnpm -F @georally/server build",
		"build:game-domain": "pnpm -F @georally/game-domain build",
		"build:tippecanoe-image": "docker build -t tippecanoe:latest packages/country-build/docker",
		"build:data": "pnpm -F @georally/country-build build:data",
		"build:country-registry": "pnpm -F @georally/country-build build:registry --out-dir ../../packages/country-catalog/generated",
		"build:map-assets": "pnpm -F @georally/country-build build:tiles --tiles-dir ../../packages/map-assets/dist/tiles --tiles-url-template /map/tiles/{z}/{x}/{y}.pbf",
		"lint": "eslint ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@types/node": "^24.10.1",
		"eslint": "^9.39.1",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.4.24",
		"globals": "^16.5.0",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.48.0"
	},
	"packageManager": "pnpm@12.9.1"
}

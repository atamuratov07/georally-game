{
	"name": "@georally/game-domain",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./src/index.ts",
	"scripts": {
		"build": "tsup",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run"
	},
	"exports": {
		".": {
			"types": "./src/index.ts",
			"development": "./src/index.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./answers": {
			"types": "./src/answers/index.ts",
			"development": "./src/answers/index.ts",
			"import": "./dist/answers/index.js",
			"default": "./dist/answers/index.js"
		},
		"./singleplayer/locate": {
			"types": "./src/singleplayer/locate/index.ts",
			"development": "./src/singleplayer/locate/index.ts",
			"import": "./dist/singleplayer/locate/index.js",
			"default": "./dist/singleplayer/locate/index.js"
		},
		"./multiplayer": {
			"types": "./src/multiplayer/index.ts",
			"development": "./src/multiplayer/index.ts",
			"import": "./dist/multiplayer/index.js",
			"default": "./dist/multiplayer/index.js"
		},
		"./multiplayer/game": {
			"types": "./src/multiplayer/game/index.ts",
			"development": "./src/multiplayer/game/index.ts",
			"import": "./dist/multiplayer/game/index.js",
			"default": "./dist/multiplayer/game/index.js"
		},
		"./multiplayer/room": {
			"types": "./src/multiplayer/room/index.ts",
			"development": "./src/multiplayer/room/index.ts",
			"import": "./dist/multiplayer/room/index.js",
			"default": "./dist/multiplayer/room/index.js"
		}
	},
	"sideEffects": false,
	"devDependencies": {
		"tsup": "^8.5.1",
		"vitest": "^4.1.10"
	}
}
